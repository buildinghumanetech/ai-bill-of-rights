# .env.example — copy to .env.local and fill in.
# Use development credentials only. Live keys belong in Vercel env (Production scope).
# See README.md → "Local development" for details.

# Neon Postgres (https://neon.tech)
# Point at a dev BRANCH of the project, not the main (production) branch.
# Create one in the Neon console: Branches → Create branch, parent = main.
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Clerk (https://clerk.com) — use the DEVELOPMENT instance keys (pk_test_, sk_test_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Resend (https://resend.com)
# Locally these are optional — emails no-op without an API key.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="AI Bill of Rights <verify@ai-for-people.org>"

# Public site URL — affects email links and OG metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob — storage for signer selfies. Required for the selfie feature
# (locally and in preview/production). Generate via:
#   pnpm dlx vercel blob store add
# or use an existing Blob store's read-write token from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
